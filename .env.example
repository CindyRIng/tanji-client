# Tanji client runtime configuration (copy to .env and fill in)
# 说明：所有 TANJI_* 变量均可通过命令行参数覆盖（优先级：CLI > env > config file > defaults）

# 探迹站点
TANJI_BASE_URL=https://sales.tungee.com
TANJI_LOGIN_URL=https://user.tungee.com/users/sign-in

# 登录凭据（建议用 600 权限的配置文件或系统密钥环，不要提交到仓库）
TANJI_PHONE=
TANJI_PASSWORD=

# 浏览器与 profile
TANJI_PROFILE_DIR=~/.tanji-client/profile
TANJI_HEADLESS=true
TANJI_BROWSER_CHANNEL=cloak

# 本地 REST / MCP
TANJI_API_TOKEN=change-me
TANJI_PORT=8787
TANJI_HOST=127.0.0.1

# 缓存（SQLite）
TANJI_CACHE_DB=~/.tanji-client/cache.db
TANJI_CACHE_DETAIL_TTL=604800
TANJI_CACHE_LIST_TTL=86400

# 会话与限频
TANJI_HEARTBEAT_SEC=300
TANJI_AUTO_RELOGIN=true
TANJI_RATE_PER_MIN=20   # 0 = 不限制（仅压测/调试；生产保持 20）
TANJI_PRIORITY_RESERVE=5   # 为解锁/登录预留的令牌数
TANJI_BULK_QUEUE_MAX=12    # 读请求队列上限，超出返回 429
TANJI_MAX_PAGES=5
TANJI_REQUEST_TIMEOUT_MS=30000
TANJI_LOG_LEVEL=info
