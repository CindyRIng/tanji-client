# tanji-client 配置示例（复制为 .env 后填写；程序会自动读取项目根目录 .env）
# 优先级：CLI 参数 > 环境变量/`.env` > ~/.tanji-client/config.json > 内置默认值
# 自定义 .env 路径：TANJI_ENV_FILE=/path/to/.env
# 不要把填写后的 .env 提交到仓库。

# ── 配置文件位置 ────────────────────────────────────────────────
# 不设置则使用 ~/.tanji-client/config.json
# TANJI_CONFIG_FILE=~/.tanji-client/config.json

# ── 探迹站点 ────────────────────────────────────────────────────
TANJI_BASE_URL=https://sales.tungee.com
TANJI_LOGIN_URL=https://user.tungee.com/users/sign-in

# ── 登录凭据（也可只写在 config.json） ────────────────────────
TANJI_PHONE=
TANJI_PASSWORD=

# ── 浏览器 / profile ────────────────────────────────────────────
TANJI_PROFILE_DIR=~/.tanji-client/profile
TANJI_HEADLESS=true
# cloak = CloakBrowser；chrome = 使用本机 Chrome（调试用）
TANJI_BROWSER_CHANNEL=cloak

# ── 本地 REST / MCP ─────────────────────────────────────────────
# 必须改成随机值；REST 默认只监听 127.0.0.1
TANJI_API_TOKEN=change-me
TANJI_HOST=127.0.0.1
TANJI_PORT=8787

# ── 缓存（SQLite） ──────────────────────────────────────────────
TANJI_CACHE_DRIVER=sqlite
TANJI_CACHE_DB=~/.tanji-client/cache.db
# 企业详情 / 联系人缓存（秒），默认 7 天
TANJI_CACHE_DETAIL_TTL=604800
# 搜索页 / 查询会话缓存（秒），默认 1 天
TANJI_CACHE_LIST_TTL=86400

# ── 会话与限频 ──────────────────────────────────────────────────
TANJI_HEARTBEAT_SEC=300
TANJI_AUTO_RELOGIN=true
# 上游总限频（次/分钟）；0 = 不限制（仅压测，生产保持 20）
TANJI_RATE_PER_MIN=20
# 为解锁/登录预留的令牌数
TANJI_PRIORITY_RESERVE=5
# 读请求等待队列上限，超出返回 429 + retryAfterMs
TANJI_BULK_QUEUE_MAX=12
TANJI_MAX_PAGES=5
TANJI_REQUEST_TIMEOUT_MS=30000

# ── 多账号 ──────────────────────────────────────────────────────
# 不设置 = 使用默认账号；多账号配置见 config.multi-account.example.json
# TANJI_ACCOUNT=main

# ── 日志（JSONL，按大小轮转） ───────────────────────────────────
TANJI_LOG_LEVEL=info
TANJI_LOG_FILE=~/.tanji-client/logs/tanji.log
TANJI_LOG_MAX_BYTES=10485760
TANJI_LOG_KEEP=5
TANJI_LOG_STDOUT=true
