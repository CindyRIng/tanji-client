{
  "name": "tanji-client",
  "version": "0.1.0",
  "private": true,
  "description": "Local client for Tungee (探迹) AI sales prospecting: persistent cloak browser session + CLI/REST/MCP/SKILL interfaces.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "tanji": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js"
  },
  "files": [
    "dist",
    "spec",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen": "tsx src/generators/generate.ts",
    "gen:check": "tsx src/generators/generate.ts --check",
    "bench": "node dist/bench/run.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cloakbrowser": "0.6.5",
    "commander": "^15.1.0",
    "playwright-core": "1.65.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "Unlicense"
}
